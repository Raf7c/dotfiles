theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Ignored on Linux.
macos-option-as-alt = true

window-decoration = true
window-padding-x = 10
window-padding-y = 10

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 21

cursor-style = block
# What makes the line above true: the shell integration forces a bar at the
# prompt "regardless of this configuration". Only the cursor feature is turned
# off; the kitty spelling and the why: docs/outils.md.
shell-integration-features = no-cursor
adjust-cell-height = 35%

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

background-blur = 20
background-opacity = 0.96

copy-on-select = clipboard
