[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    # "editor" instead of the built-in "nvimdiff": the tool follows $EDITOR
    # (nvim, exported by shell/env.sh) — change the editor once, diff and
    # merge follow. Same design as the school repo.
    tool = editor

[difftool]
    prompt = false

[difftool "editor"]
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$REMOTE\"

[merge]
    tool = editor
    conflictStyle = zdiff3

[mergetool "editor"]
    # 4 windows: LOCAL / BASE / REMOTE on top, MERGED (the one to save) at
    # the bottom — same layout as git's built-in vimdiff3.
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c '4wincmd w' -c 'wincmd J'
    # The exit code of an editor says nothing about the merge: git must ask.
    trustExitCode = false

[fetch]
    prune = true
    pruneTags = true
    all = true

[help]
    autocorrect = prompt

[commit]
    verbose = true

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[transfer]
    fsckObjects = true

[alias]
    d = diff
    ck = checkout
    cm = commit
    cma = commit -a
    st = status
    br = branch
    bra = branch -a
[gpg]
    format = ssh

# gpg.ssh.* lives entirely in config.local (gitsign step): `program`
# differs per OS, and allowedSignersFile must follow XDG — git expands no
# variable in pathname values, so the shell expands it at generation time.

# Machine-local settings (signing key, commit.gpgsign, gpg.ssh.program):
# kept OUT of the repo so the same config works on every machine.
# Generated by `./run install gitsign`, gitignored. The path is relative to
# THIS file; git ignores a missing include silently.
[include]
    path = config.local
