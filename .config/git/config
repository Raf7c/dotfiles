[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[init]
    defaultBranch = main

[core]
    ignorecase = false

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    tool = nvimdiff

[difftool]
    prompt = false

[merge]
    tool = nvimdiff
    conflictStyle = zdiff3

[fetch]
    prune = true
    pruneTags = true
    all = true

[help]
    autocorrect = prompt

[commit]
    verbose = true

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[transfer]
    fsckObjects = true

[alias]
    d = diff
    ck = checkout
    cm = commit
    cma = commit -a
    st = status
    br = branch
    bra = branch -a
[gpg]
    format = ssh

# gpg.ssh.* lives entirely in config.local (gitsign step): `program`
# differs per OS, and allowedSignersFile must follow XDG — git expands no
# variable in pathname values, so the shell expands it at generation time.

# Machine-local settings (signing key, commit.gpgsign, gpg.ssh.program):
# kept OUT of the repo so the same config works on every machine.
# Generated by `./run install gitsign`, gitignored. The path is relative to
# THIS file; git ignores a missing include silently.
[include]
    path = config.local
