[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    # "editor" rather than the built-in "nvimdiff": the tool follows $EDITOR,
    # so changing the editor once moves diff and merge with it.
    tool = editor

[difftool]
    prompt = false

[difftool "editor"]
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$REMOTE\"

[merge]
    tool = editor
    conflictStyle = zdiff3

[mergetool "editor"]
    # LOCAL / BASE / REMOTE on top, MERGED (the one to save) below.
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c '4wincmd w' -c 'wincmd J'
    # The exit code of an editor says nothing about the merge: git must ask.
    trustExitCode = false

[fetch]
    prune = true
    pruneTags = true
    all = true

[help]
    autocorrect = prompt

[commit]
    verbose = true

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[transfer]
    fsckObjects = true

[gpg]
    format = ssh

# gpg.ssh.* lives entirely in config.local: `program` differs per OS, and git
# expands no variable in pathname values, so allowedSignersFile has to be
# expanded at generation time.

# ------------------ Per-forge identity ------------------
# The email above stays the DEFAULT, and it has to: a repository matching
# neither condition below must still have an email, or git refuses to commit.
# GitLab is an override, declared twice on purpose:
#   gitdir    matches on the PATH, so a `git init` in ~/lab/gitlab is right
#             from its very first commit, before any remote exists;
#   hasconfig matches on the REMOTE URL, so a GitLab repo cloned ANYWHERE else
#             is right too. That one is what makes the ~/lab layout a
#             convenience rather than a requirement.
# Together they cover each other. One blind spot remains: a repo outside
# ~/lab/gitlab with no remote yet. Add the remote before the first commit, or
# repair with `git commit --amend --reset-author`. See README.md here.
# `hasconfig` needs git >= 2.36. The ~/lab path is written out because git
# expands no variable in a condition: move $REPOS and move this line too.
[includeIf "gitdir:~/lab/gitlab/"]
    path = config.gitlab
[includeIf "hasconfig:remote.*.url:git@gitlab.com:**/**"]
    path = config.gitlab

# Machine-local settings, generated by `./run install gitsign` and gitignored,
# so the same versioned config works on every machine. The path is relative to
# THIS file, and git ignores a missing include silently.
[include]
    path = config.local
