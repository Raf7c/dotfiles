#!/usr/bin/env sh
# run: single entry point for the dotfiles. Dispatches to a subcommand.

set -eu

# Always invoked from the repo, never through a symlink: manifest.sh links
# scripts/, not this file. CDPATH='' (not `CDPATH=`, SC1007) keeps `cd` silent.
DOTFILES_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
export DOTFILES_DIR

# Single source of truth for the order. See docs/installer.md, adding a step.
STEPS="prereqs submodules directories migrate symlinks packages gitsign runtimes plugins shell"
export STEPS

usage() {
  cat <<EOF
run: dotfiles installer (macOS)

Usage:
  ./run <command> [options] [steps...]

Commands:
  install
  update
  upgrade

Steps (install only, exact names):
  $STEPS

Options:
  -y, --yes       proceed without confirmation (irreversible steps included)
  -n, --dry-run   print the actions without running anything
  -h, --help      show this help

Examples:
  ./run install                       # install everything
  ./run install -n                    # preview, run nothing
  ./run install symlinks packages     # only these steps
  ./run install -y                    # install without any confirmation prompt
  ./run update                        # git pull, then resync from the repo
  ./run upgrade -n                    # preview the updates

Details: README.md
EOF
}

# First arg = command (no dash; help/empty handled here).
case "${1:-}" in
  '' | -h | --help | help)
    usage
    exit 0
    ;;
esac
cmd=$1
shift
case "$cmd" in
  install | update | upgrade) ;;
  *)
    printf 'unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac

# Options + remaining step names.
DRY_RUN=0
ASSUME_YES=0
STEPS_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -y | --yes) ASSUME_YES=1 ;;
    -n | --dry-run) DRY_RUN=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *) STEPS_ARG="$STEPS_ARG $1" ;;
  esac
  shift
done

# Step names are expanded unquoted below: no globbing, so `./run install '*'`
# cannot become a list of filenames. NEVER turned back on -- steps are sourced
# in this shell, so a step cannot rely on a glob.
set -f

# Steps only apply to install (update/upgrade have a fixed scope).
if [ "$cmd" != install ] && [ -n "$STEPS_ARG" ]; then
  printf 'steps not supported for "%s":%s\n' "$cmd" "$STEPS_ARG" >&2
  usage >&2
  exit 2
fi

# Exact match against $STEPS: a typo must fail loudly, not silently "succeed"
# by running nothing.
for _m in $STEPS_ARG; do
  _found=0
  for _s in $STEPS; do [ "$_s" = "$_m" ] && _found=1; done
  if [ "$_found" != 1 ]; then
    printf 'unknown step: %s\navailable steps: %s\n' "$_m" "$STEPS" >&2
    exit 2
  fi
done

RUN_TS=$(date +%Y%m%d%H%M%S) # unique run timestamp (backup directory)

# Single source of truth for the repos root (env.sh sets it for interactive
# shells): the manifest uses ${REPOS} with no fallback.
REPOS="${REPOS:-$HOME/lab}"

export DRY_RUN ASSUME_YES STEPS_ARG RUN_TS REPOS

# Shared libraries
. "$DOTFILES_DIR/setup/lib/log.sh"
. "$DOTFILES_DIR/setup/lib/util.sh"

# macOS only, and the message says so: there is no list of supported systems
# this one failed to join. Straight uname, no lib: one test, one caller.
[ "$(uname -s)" = Darwin ] || {
  log_error "macOS only (uname: $(uname -s))"
  exit 1
}
# The manifest's second column is relative to $HOME, while dotfiles_dirs and
# gitsign expand ${XDG_CONFIG_HOME:-...}. A relocated value makes the two
# disagree in silence, every step still printing a ✓ over a shell with no
# configuration at all. An assertion, not dead code.
[ "${XDG_CONFIG_HOME:-$HOME/.config}" = "$HOME/.config" ] || {
  log_error "XDG_CONFIG_HOME must be ~/.config (the link manifest assumes it)"
  exit 1
}
log_step "command: $cmd   |   macOS"
[ "$DRY_RUN" = 1 ] && log_warn "DRY-RUN: no action will be performed"

# Preamble warnings (e.g. the DRY-RUN notice) must not count as failures.
log_reset_counts

# shellcheck disable=SC1090
. "$DOTFILES_DIR/setup/commands/$cmd.sh"
