#!/usr/bin/env sh
# run: single entry point for the dotfiles. Dispatches to a subcommand.

set -eu

# Resolve $0 THROUGH the symlinks before deriving the repo root: `run` is
# meant to be reachable from ~/.dotfiles/run or from a link in the PATH, and
# dirname of a link points at the link, not at the repo.
# `readlink -f` is GNU-only (missing on macOS < 12), so walk the chain by
# hand: POSIX, and CDPATH='' (not `CDPATH=`, SC1007) keeps `cd` silent.
_self=$0
case "$_self" in
  */*) ;;
  *) _self=$(command -v -- "$_self") || {
    printf 'run: cannot locate %s\n' "$0" >&2
    exit 1
  } ;;
esac
_hops=0
while [ -L "$_self" ]; do
  _hops=$((_hops + 1))
  if [ "$_hops" -gt 40 ]; then
    printf 'run: too many symlink levels for %s\n' "$0" >&2
    exit 1
  fi
  _dir=$(CDPATH='' cd -- "$(dirname -- "$_self")" && pwd)
  _target=$(readlink -- "$_self")
  case "$_target" in
    /*) _self=$_target ;;
    *) _self="$_dir/$_target" ;;
  esac
done
DOTFILES_DIR=$(CDPATH='' cd -- "$(dirname -- "$_self")" && pwd)
export DOTFILES_DIR

# SINGLE source of truth for the order. To insert a step: create
# setup/steps/<name>.sh then add <name> here, at the right position.
STEPS="prereqs submodules directories migrate symlinks packages gitsign runtimes plugins shell"
export STEPS

usage() {
  cat <<EOF
run: dotfiles installer (macOS · Fedora)

Usage:
  ./run <command> [options] [steps...]

Commands:
  install
  update
  upgrade

Steps (install only, exact names):
  $STEPS

Options:
  -y, --yes       proceed without confirmation (irreversible steps included)
  -n, --dry-run   print the actions without running anything
  -h, --help      show this help

Examples:
  ./run install                       # install everything
  ./run install -n                    # preview, run nothing
  ./run install symlinks packages     # only these steps
  ./run update -y                     # resync without confirmation
  ./run upgrade -n                    # preview the updates

Details: README.md
EOF
}

# First arg = command (no dash; help/empty handled here).
case "${1:-}" in
  '' | -h | --help | help)
    usage
    exit 0
    ;;
esac
cmd=$1
shift
case "$cmd" in
  install | update | upgrade) ;;
  *)
    printf 'unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac

# Options + remaining step names.
DRY_RUN=0
ASSUME_YES=0
STEPS_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    -y | --yes) ASSUME_YES=1 ;;
    -n | --dry-run) DRY_RUN=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *) STEPS_ARG="$STEPS_ARG $1" ;;
  esac
  shift
done

# Options are parsed: from here on, step names are only ever expanded
# unquoted ($STEPS_ARG). Disable globbing so `./run install '*'` (or a stray
# file named like a step) can never turn into a list of filenames.
set -f

# Steps only apply to install (update/upgrade have a fixed scope).
if [ "$cmd" != install ] && [ -n "$STEPS_ARG" ]; then
  printf 'steps not supported for "%s":%s\n' "$cmd" "$STEPS_ARG" >&2
  usage >&2
  exit 2
fi

# Validate step names (exact match against $STEPS): a typo must fail
# loudly, not silently "succeed" by running nothing.
for _m in $STEPS_ARG; do
  _found=0
  for _s in $STEPS; do [ "$_s" = "$_m" ] && _found=1; done
  if [ "$_found" != 1 ]; then
    printf 'unknown step: %s\navailable steps: %s\n' "$_m" "$STEPS" >&2
    exit 2
  fi
done

RUN_TS=$(date +%Y%m%d%H%M%S) # unique run timestamp (backup directory)

# SINGLE source of truth for the repos root (also set by shell/env.sh for
# interactive shells): the manifest uses ${REPOS} without any fallback.
REPOS="${REPOS:-$HOME/lab}"

export DRY_RUN ASSUME_YES STEPS_ARG RUN_TS REPOS

# Shared libraries
. "$DOTFILES_DIR/setup/lib/log.sh"
. "$DOTFILES_DIR/setup/lib/os.sh"
. "$DOTFILES_DIR/setup/lib/util.sh"

detect_os
log_step "command: $cmd   |   OS: $OS"
[ "$OS" = unknown ] && {
  log_error "unsupported OS"
  exit 1
}
[ "$DRY_RUN" = 1 ] && log_warn "DRY-RUN: no action will be performed"

# Preamble warnings (e.g. the DRY-RUN notice) must not count as failures.
log_reset_counts

# shellcheck disable=SC1090
. "$DOTFILES_DIR/setup/commands/$cmd.sh"
