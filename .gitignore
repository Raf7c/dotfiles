# macOS Terminal.app session files
.zsh_sessions

# macOS
.DS_Store

# IDE junk. Also in .config/git/ignore for every repo, but a clone of THIS
# repo must be clean before that global config is linked.
.idea/
.vscode/

# tmux plugins (managed by TPM, not versioned)
.config/tmux/plugins/

# Claude Code local state (settings.local.json, session data)
.claude/

# Machine-local git settings: signing key, commit.gpgsign, gpg.ssh.program.
# Generated by the gitsign step, included by .config/git/config.
.config/git/config.local

# compinit cache: ours goes to XDG (~/.cache/zsh), but any compinit run
# without -d drops its dump at the default $ZDOTDIR path, inside this repo.
.config/zsh/.zcompdump*
