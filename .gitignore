# macOS Terminal.app session files
.zsh_sessions

# macOS
.DS_Store

# Also in .config/git/ignore, but a clone of THIS repo must be clean before
# that global config is linked.
.idea/
.vscode/

# tmux plugins (managed by TPM, not versioned)
.config/tmux/plugins/

# Claude Code local state (settings.local.json, session data)
.claude/

# Machine-local git settings, generated by the gitsign step.
.config/git/config.local

# Ours goes to ~/.cache/zsh, but any compinit run without -d drops its dump at
# the default $ZDOTDIR path, inside this repo.
.config/zsh/.zcompdump*
