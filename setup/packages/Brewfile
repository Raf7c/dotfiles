# Sections mirror fedora.txt so the two files read side by side.

# ------------------------------ formulas ------------------------------

# core — shell, multiplexer, vcs
brew "git"
brew "tmux"
brew "zsh"
brew "bash"
brew "bash-completion@2"

# modern CLI — each tool's "replaces + why": docs/tools.md
brew "tree"
brew "eza"
brew "zoxide"
brew "fzf"
brew "bat"
brew "fd"
brew "ripgrep"
brew "btop"
brew "jq"
brew "lazygit"

# build & tasks
brew "make"
brew "cmake"
brew "just"

# prompt & runtimes
brew "starship"
brew "mise"    # runtimes (node, python, rust, neovim) AND the pinned
               # authority tools (shellcheck, shfmt, yamllint) — one
               # installer per tool, versions in .config/mise/config.toml

# infra / automation
brew "ansible"
brew "ansible-lint"

# network
brew "cloudflared"   # macOS only (not installed on Fedora)

# secrets / security (Fedora equivalents in fedora.txt)
brew "gnupg"
brew "age"                  # modern file encryption
brew "sops"                 # secrets in git (age/KMS backends)
brew "age-plugin-yubikey"   # age identities backed by a YubiKey
brew "ykman"                # YubiKey Manager CLI
brew "openssh"              # macOS only: Apple's ssh-keygen lacks FIDO2/sk support
brew "libfido2"             # macOS only: FIDO2 lib for the sk-* keys above

# ------------------------------- casks --------------------------------

# terminal & font
cask "ghostty"
cask "kitty"   # fallback, mirrors ghostty — see .config/kitty
# Nerd Font: starship, eza --icons and the tmux status bar print glyphs
# from its private range — without it the prompt is a row of tofu.
# Family name: "JetBrainsMono Nerd Font Mono" (ghostty/config).
cask "font-jetbrains-mono-nerd-font"

# dev GUI
# (claude code CLI: official script in packages.sh, NOT brew — the
#  formula lags behind Anthropic's release pace)
cask "jetbrains-toolbox"
cask "gitkraken"
cask "docker-desktop"   # engine + CLI (the `docker` formula is CLI-only)

# productivity
cask "raycast"
cask "keymapp"
cask "obsidian"

# AI
cask "claude"

# browsers
cask "firefox"
cask "google-chrome"
