# Read by most editors AND by shfmt. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shfmt is the authority here, see docs/maintenance.md.
# switch_case_indent keeps `case` branches one level in.
[{*.sh,*.zsh,.z*,run,.bashrc,.bash_profile}]
indent_style = space
indent_size = 2
switch_case_indent = true

# Written by git itself, in its canonical tab-indented format.
[.gitmodules]
indent_style = tab
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
